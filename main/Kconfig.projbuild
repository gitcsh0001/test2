menu "Modbus Slave Configuration"

    comment "These are factory defaults; all values can be changed at"
    comment "runtime from the web UI and are then persisted in NVS."

    config MB_SLAVE_ADDR
        int "Default Modbus slave address (UID)"
        range 1 247
        default 1

    choice MB_SLAVE_INIT_MODE
        prompt "Default communication mode"
        default MB_SLAVE_INIT_RTU
        help
            Mode used on first boot (before any web configuration is saved).
            At runtime the web UI can switch between RTU and TCP and edit all
            parameters; both transports are always compiled in.

        config MB_SLAVE_INIT_RTU
            bool "Modbus RTU (serial)"
        config MB_SLAVE_INIT_TCP
            bool "Modbus TCP (network)"
    endchoice

    comment "--- RTU defaults ---"

    config MB_SLAVE_UART_PORT_NUM
        int "Default UART port number"
        range 0 2
        default 1
        help
            TXD / RXD / RTS pins are set under
            "Component config -> Modbus configuration".

    config MB_SLAVE_UART_BAUD
        int "Default UART baud rate"
        range 1200 921600
        default 115200

    comment "--- TCP defaults ---"

    config MB_SLAVE_TCP_PORT
        int "Default Modbus TCP port"
        range 1 65535
        default 502
        help
            Wi-Fi / Ethernet credentials are set under
            "Example Connection Configuration".

endmenu
